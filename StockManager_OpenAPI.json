{
  "openapi": "3.0.3",
  "info": {
    "title": "StockManager API",
    "version": "1.0.0",
    "description": "Bearer-token inventory API with role authorization, row-locked stock updates, and an immutable stock ledger.",
    "contact": {
      "name": "Muhammad Ali Nawaz"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Products"
    },
    {
      "name": "Suppliers"
    },
    {
      "name": "Stock"
    },
    {
      "name": "Reports"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Sanctum personal access token"
      }
    },
    "schemas": {
      "LoginInput": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@example.com"
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "device_name": {
            "type": "string",
            "maxLength": 100,
            "example": "local-client"
          }
        }
      },
      "ProductCreateInput": {
        "type": "object",
        "required": [
          "name",
          "price",
          "minimum_quantity"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "opening_stock": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000,
            "description": "Creates an opening stock_in ledger movement."
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "minimum_quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "supplier_id": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          },
          "category": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          }
        }
      },
      "ProductUpdateInput": {
        "type": "object",
        "required": [
          "name",
          "price",
          "minimum_quantity"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "minimum_quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "supplier_id": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          },
          "category": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          }
        },
        "description": "Quantity and opening_stock are intentionally not accepted. Use stock movement endpoints."
      },
      "ProductPatchInput": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 5000
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0,
            "maximum": 9999999999.99
          },
          "minimum_quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "supplier_id": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          },
          "category": {
            "type": "string",
            "nullable": true,
            "maxLength": 120
          }
        },
        "description": "Any supplied metadata field is updated. Quantity and opening_stock remain prohibited."
      },
      "SupplierInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 40
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        }
      },
      "SupplierPatchInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "email": {
            "type": "string",
            "format": "email",
            "nullable": true,
            "maxLength": 255
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 40
          },
          "address": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        }
      },
      "StockInput": {
        "type": "object",
        "required": [
          "product_id",
          "quantity"
        ],
        "properties": {
          "product_id": {
            "type": "integer",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "note": {
            "type": "string",
            "nullable": true,
            "maxLength": 2000
          }
        }
      },
      "ReversalInput": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          }
        }
      }
    }
  },
  "paths": {
    "/api/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Create a bearer token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "422": {
            "description": "Validation failed"
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "Revoke the current bearer token",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/user": {
      "get": {
        "summary": "Get the current bearer-authenticated user",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/products": {
      "get": {
        "summary": "List products",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          },
          {
            "name": "supplier_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      },
      "post": {
        "summary": "Create a product and optional opening movement",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "Product created"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "tags": [
          "Products"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreateInput"
              }
            }
          }
        }
      }
    },
    "/api/products/export": {
      "get": {
        "summary": "Export products as XLSX",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "XLSX file",
            "content": {
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {}
            }
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "supplier_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            }
          }
        ]
      }
    },
    "/api/products/{product}": {
      "get": {
        "summary": "Show a product",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Product"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        },
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "required": true,
            "description": "Product ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      },
      "put": {
        "summary": "Replace product metadata",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "required": true,
            "description": "Product ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductUpdateInput"
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Partially update product metadata",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "422": {
            "description": "Validation failed"
          }
        },
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "required": true,
            "description": "Product ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductPatchInput"
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Archive a zero-stock product",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Product archived"
          },
          "401": {
            "description": "Unauthenticated"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "422": {
            "description": "Stock must be zero"
          }
        },
        "tags": [
          "Products"
        ],
        "parameters": [
          {
            "name": "product",
            "in": "path",
            "required": true,
            "description": "Product ID",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ]
      }
    },
