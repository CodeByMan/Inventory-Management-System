APP_NAME=StockManager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# StockManager uses SQLite for its documented local setup.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# API authentication is bearer-token-only. No stateful SPA domains are used.
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=stockmanager_

# Demo seeding is opt-in and must remain disabled in production.
ALLOW_DEMO_SEEDING=false
DEMO_NAME="StockManager Admin"
DEMO_EMAIL=admin@example.com
DEMO_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

L5_SWAGGER_GENERATE_ALWAYS=false
VITE_APP_NAME="${APP_NAME}"
